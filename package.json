{
    "name": "test_2",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/share/types",
        "packages/share/utils",
        "packages/frontend/*",
        "packages/backend/*",
        "packages/prisma",
        "packages/php"
    ],
    "scripts": {
        "dev:backend": "npm run dev -w apps/backend",
        "dev:frontend": "npm run dev -w apps/frontend",
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "build": "npm run build -w apps/backend && npm run build -w apps/frontend",
        "test": "npm run test -w apps/backend && npm run test -w apps/frontend",
        "test:front": "npm run test -w apps/frontend",
        "test:back": "npm run test -w apps/backend",
        "prisma:generate": "npx -w packages/prisma prisma generate",
        "prisma:migrate": "npx -w packages/prisma prisma migrate dev",
        "seed": "npx -w packages/prisma prisma db seed",
        "demo:requests": "tsx scripts/demoRequest.ts"
    },
    "devDependencies": {
        "@faker-js/faker": "^9.9.0",
        "concurrently": "^8.2.2",
        "tsx": "^4.22.4",
        "typescript": "^5.3.3"
    }
}
