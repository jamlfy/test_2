{
  "name": "@test_2/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "jest"
  },
  "dependencies": {
    "@auth0/auth0-vue": "^2.2.0",
    "@shopify/polaris": "^12.3.0",
    "@shopify/polaris-icons": "^7.9.0",
    "@test_2/frontend-auth": "*",
    "@test_2/frontend-inventory": "*",
    "@test_2/frontend-order": "*",
    "@test_2/frontend-summary": "*",
    "axios": "^1.6.5",
    "pinia": "^2.1.7",
    "vue": "^3.4.5",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@pinia/testing": "^0.1.3",
    "@vitejs/plugin-vue": "^5.0.2",
    "@vue/test-utils": "^2.4.3",
    "@vue/tsconfig": "^0.5.0",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^30.4.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vue-tsc": "^1.8.27"
  },
  "jest": {
    "roots": [
      "<rootDir>/packages/frontend",
      "<rootDir>/apps/frontend"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts",
      "vue"
    ],
    "rootDir": "../../",
    "testRegex": ".*\\.spec\\.ts$",
    "globals": {
      "vue-jest": {
        "tsConfig": "apps/frontend/tsconfig.json"
      }
    },
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "apps/frontend/tsconfig.json",
          "diagnostics": false
        }
      ],
      ".*\\.vue$": [
        "@vue/vue3-jest",
        {
          "tsconfig": "apps/frontend/tsconfig.json"
        }
      ]
    },
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^@test_2/frontend-(.*)$": "<rootDir>/packages/frontend/$1",
      "^@test_2/share-types(|/.*)$": "<rootDir>/packages/share/types/$1",
      "^@test_2/share-utils(|/.*)$": "<rootDir>/packages/share/utils/$1"
    }
  }
}
