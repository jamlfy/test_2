{
  "name": "@test_2/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "nest start",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/config": "^3.1.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.0.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.2.0",
    "@nestjs/bullmq": "^10.0.0",
    "@prisma/client": "^5.8.0",
    "bullmq": "^5.7.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "jwks-rsa": "^3.1.0",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.1",
    "@test_2/share-types": "*",
    "@test_2/share-utils": "*",
    "@test_2/backend-orders": "*",
    "@test_2/backend-inventory": "*",
    "@test_2/backend-packaging": "*",
    "@test_2/prisma": "*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.8.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "roots": ["<rootDir>/packages/backend", "<rootDir>/apps/backend"],
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "../../",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", {
        "tsconfig": "tsconfig.json",
        "diagnostics": false
      }]
    },
    "collectCoverageFrom": ["packages/backend/**/*.(t|j)s"],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@test_2/share-types(|/.*)$": "<rootDir>/packages/share/types/$1",
      "^@test_2/share-utils(|/.*)$": "<rootDir>/packages/share/utils/$1",
      "^@test_2/backend-(.*)$": "<rootDir>/packages/backend/$1",
      "^@test_2/prisma(|/.*)$": "<rootDir>/packages/prisma/$1"
    }
  }
}
